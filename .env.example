# API Configuration
# Base URL for the backend API
NEXT_PUBLIC_API_BASE_URL=https://sandbox.timroticket.com/api/v1

# Google Maps (for venue address autocomplete)
# Get an API key from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Flag to allow event editing after approval by admin until the event goes live
NEXT_PUBLIC_ALLOW_EDIT_APPROVED_EVENTS=false
